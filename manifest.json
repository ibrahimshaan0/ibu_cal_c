{
  "manifest_version": 3,
  "name": "IBU_CAL_C",
  "version": "1.2.1",
  "description": "A compact calculator, scientific tools, land-area converters, and an optional best-effort F1 key guard.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "IBU_CAL_C",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "f1-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
